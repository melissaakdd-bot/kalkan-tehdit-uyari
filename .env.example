# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun. .env depoya eklenmez.

# Panel/API erişim anahtarı (sunucu başka makinelere açılacaksa zorunlu)
KALKAN_TOKEN=

# Claude katmanı (KVKK değerlendirmesinden sonra açın)
KALKAN_LLM=0
ANTHROPIC_API_KEY=

# Tarayıcı eklentisinin indirdiği dosyalar yalnızca bu klasörden okunur
KALKAN_INDIRME_DIZINI=~/Downloads

# İsteğe bağlı entegrasyonlar
VIRUSTOTAL_API_KEY=
KALKAN_WEBHOOK_URL=
KALKAN_WATCH_DIR=

# Posta kutusu izleme (uygulamaya özel şifre kullanın)
KALKAN_IMAP_HOST=
KALKAN_IMAP_USER=
KALKAN_IMAP_PASSWORD=
KALKAN_IMAP_FOLDER=INBOX
